# wa-pull environment variables

# ── REQUIRED: Gemini API key ──────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
# Replace the value below with your key (keep the quotes):
GEMINI_API_KEY="your_gemini_api_key_here"

# Your WhatsApp phone number (with country code, no +)
# e.g. 919876543210
# Auto-detected from the bridge DB if not set.
OWNER_PHONE_NUMBER=""

# ── Database paths (auto-detected if not set) ───────────────────────────────
# These point to the SQLite DBs produced by the Go bridge
MESSAGES_DB_PATH=""
WHATSAPP_DB_PATH=""

# ── Bridge API ───────────────────────────────────────────────────────────────
WA_API_URL="http://localhost:8080"

# ── LLM Models ───────────────────────────────────────────────────────────────
GEMINI_MODEL_FAST="gemini-2.5-flash"
GEMINI_MODEL_PRO="gemini-2.5-pro"

# ── Scheduler ────────────────────────────────────────────────────────────────
# An hourly session starts at the top of every hour, 8 AM–midnight IST.
# At :50 (10 min before the next hour) the OKF is updated and an hour
# wrap-up message is sent with new context absorbed this hour.
IST_START_HOUR="8"
IST_END_HOUR="24"
WRAPUP_MINUTE="50"

# Session inactivity timeout (seconds). Default 3600 = stays alive for the hour.
SESSION_TIMEOUT_SECONDS="3600"

# How many tasks the hourly bulletin shows (compact one-line format).
TASKS_PER_PAGE="20"

# Lookback window for OKF (days)
OKF_LOOKBACK_DAYS="14"

# ── Real-time monitor (pulse) ────────────────────────────────────────────────
# Watches all non-archived chats. Triggers on:
#   - you send a message in any chat
#   - someone tags you
#   - someone asks you a question
#   - 4+ messages in quick succession in a group
# Generates a "pulse" alert with a task (appended to session) + A/B/C options.
MONITOR_ENABLED="1"
MONITOR_POLL_INTERVAL="10"     # seconds between scans of all chats
MONITOR_COOLDOWN_SECONDS="300" # per-chat cooldown after an alert fires
MONITOR_CONTEXT_MESSAGES="30"  # how many recent msgs the LLM sees per trigger
